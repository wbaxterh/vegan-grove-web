# Base URL of the Vegan Grove API including the /api prefix (dev default: http://localhost:4000/api)
NEXT_PUBLIC_API_BASE_URL=
# Origin that serves uploaded images and posters, e.g. https://media.vegangrove.org (also allowed in the CSP)
NEXT_PUBLIC_MEDIA_CDN_ORIGIN=
# Canonical origin of this site, used by robots.txt, sitemap.xml, llms.txt and metadata (default: https://vegangrove.org)
NEXT_PUBLIC_SITE_URL=
# Force the Secure flag on the vg_session cookie: true or false (default: true in production, false in development)
SESSION_COOKIE_SECURE=
